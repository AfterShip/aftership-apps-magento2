{
    "name": "aftership/aftership-apps-magento2",
    "description": "AfterShip extension for Magento 2. Allows connect with AfterShip and more.",
    "type": "magento2-module",
    "version": "1.0.4",
    "minimum-stability": "stable",
    "license": "MIT",
    "keywords": ["aftership", "magento", "magento2", "magento-2", "tracking", "shipping"],
    "authors": [
        {
            "name": "AfterShip",
            "email": "support@aftership.com"
        }
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "AfterShip\\Tracking\\": ""
        }
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "require": {
        "php": ">=7.1.0",
        "magento/module-quote": ">=101.1.3"
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    }
}
